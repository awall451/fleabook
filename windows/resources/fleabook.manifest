<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Fleabook" version="1.0.0.0" processorArchitecture="amd64"/>

  <!-- System DPI aware, deliberately not PerMonitorV2. PerMonitorV2 requires the
       window to handle WM_DPICHANGED by resizing itself, and go-webview2's window
       procedure does not — declaring it would leave the window the wrong physical
       size after a drag between differently-scaled monitors. System awareness is
       crisp on the monitor the app starts on and only degrades to Windows' bitmap
       scaling if it is moved to one with a different scale factor. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <!-- Without a supportedOS entry Windows applies Vista-era compatibility
       shims, which among other things lies about the OS version. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 and 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Windows 8.1 -->
    </application>
  </compatibility>

  <!-- asInvoker: Fleabook installs per-user and writes only to %LOCALAPPDATA%,
       so it must never trigger a UAC prompt. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
